{
  "manifest_version": 3,
  "name": "ConTrac",
  "short_name": "ConTrac",
  "version": "1.3.0",
  "description": "Track coding contests with reliable local reminders, verified Google account sync, and diagnostics.",
  "key": "",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "identity",
    "windows"
  ],
  "host_permissions": [
    "https://codeforces.com/*",
    "https://alfa-leetcode-api.onrender.com/*",
    "https://www.googleapis.com/*",
    "https://oauth2.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "ConTrac",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup.html"
  }
}